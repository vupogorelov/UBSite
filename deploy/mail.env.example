# The mailbox letters go from (restoring a password, confirming an e-mail) — see DEPLOY.md «Почта».
# Copy this file to deploy/mail.env, fill it in and restart the platform (deploy\restart.ps1).
# mail.env holds a password: keep it on the server only, never share or publish it.

# Yandex Mail: smtp.yandex.ru, port 465 (TLS). The password is an "app password"
# (Яндекс ID → Безопасность → Пароли приложений → Почта), not the account's own password.
UB_SMTP_HOST=smtp.yandex.ru
UB_SMTP_PORT=465
UB_SMTP_USER=upexplorer@yandex.ru
UB_SMTP_PASS=app-password-here

# The sender as people see it (by default the mailbox itself and «Urantia Papers Explorer»).
# UB_MAIL_FROM=upexplorer@yandex.ru
# UB_MAIL_NAME=Urantia Papers Explorer

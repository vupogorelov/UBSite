# Urantian Docs Explorer — HTTPS in front of the Node server (which listens on 127.0.0.1:4300 only).
# Caddy obtains and renews the certificate by itself (Let's Encrypt, falling back to ZeroSSL);
# ports 80 and 443 must reach this computer from the internet.
{
	# Certificates and the ACME account live next to this file, not in the user's profile.
	storage file_system ./caddy-data
}

95-31-142-59.broadband.corbina.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Live chat events (Server-Sent Events): pass every event through at once, never compress.
	@stream path /api/chat/stream
	handle @stream {
		reverse_proxy 127.0.0.1:4300 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4300
	}

	log {
		output file ./logs/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
